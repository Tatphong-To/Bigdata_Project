# Copy to .env and fill in. .env is git-ignored — never commit real keys.

# Spoonacular free API key (register at https://spoonacular.com/food-api/console)
SPOONACULAR_API_KEY=

# Daily quota in POINTS, not requests. Conservative default until the value
# shown in your Spoonacular account console is confirmed.
# See docs/spoonacular-quota.md for the point-cost breakdown.
SPOONACULAR_DAILY_POINT_QUOTA=50

# Postgres (matches docker-compose.yml defaults; change for production)
POSTGRES_USER=food_user
POSTGRES_PASSWORD=food_pass
# Host port to publish Postgres on. Change if 5432 is already used locally.
POSTGRES_HOST_PORT=5432
